/// Entirely synthetic. SYN-FIN-2026-11. No external data source or approved financial input.
table finance_costs

	measure 'Base operating cost' = CALCULATE(SUM(finance_costs[operating_eur]), REMOVEFILTERS(finance_scenarios), finance_costs[scenario] = "Base")
		formatString: "EUR "#,0;("EUR "#,0);"EUR "0

	column scenario
		dataType: string
		summarizeBy: none
		sourceColumn: scenario

	column component
		dataType: string
		summarizeBy: none
		sourceColumn: component

	column fixed_eur
		dataType: double
		summarizeBy: none
		sourceColumn: fixed_eur

	column variable_per_passport_eur
		dataType: double
		summarizeBy: none
		sourceColumn: variable_per_passport_eur

	column operating_eur
		dataType: double
		summarizeBy: none
		sourceColumn: operating_eur

	column investment_eur
		dataType: double
		summarizeBy: none
		sourceColumn: investment_eur

	column data_label
		dataType: string
		summarizeBy: none
		sourceColumn: data_label

	column model_version
		dataType: string
		summarizeBy: none
		sourceColumn: model_version

	partition finance_costs = m
		mode: import
		source =
			#table(
				type table [scenario = text, component = text, fixed_eur = nullable number, variable_per_passport_eur = nullable number, operating_eur = nullable number, investment_eur = nullable number, data_label = text, model_version = text],
