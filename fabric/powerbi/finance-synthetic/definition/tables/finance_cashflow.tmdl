/// Entirely synthetic. SYN-FIN-2026-11. No external data source or approved financial input.
table finance_cashflow

	measure 'Base annual cash' = CALCULATE(SUM(finance_cashflow[net_cash_eur]), REMOVEFILTERS(finance_scenarios), finance_cashflow[scenario] = "Base")
		formatString: "EUR "#,0;("EUR "#,0);"EUR "0

	measure 'Base cumulative cash' = CALCULATE(MAX(finance_cashflow[cumulative_cash_eur]), REMOVEFILTERS(finance_scenarios), finance_cashflow[scenario] = "Base")
		formatString: "EUR "#,0;("EUR "#,0);"EUR "0

	measure 'Base efficiency cash' = CALCULATE(SUM(finance_cashflow[manual_avoided_eur]) - SUM(finance_cashflow[operating_eur]) - SUM(finance_cashflow[investment_eur]), REMOVEFILTERS(finance_scenarios), finance_cashflow[scenario] = "Base")
		formatString: "EUR "#,0;("EUR "#,0);"EUR "0

	measure 'Base upside cash' = CALCULATE(SUM(finance_cashflow[premium_eur]) + SUM(finance_cashflow[circular_eur]), REMOVEFILTERS(finance_scenarios), finance_cashflow[scenario] = "Base")
		formatString: "EUR "#,0;("EUR "#,0);"EUR "0

	column scenario
		dataType: string
		summarizeBy: none
		sourceColumn: scenario

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column period
		dataType: string
		summarizeBy: none
		sourceColumn: period
		sortByColumn: year

	column passports
		dataType: int64
		summarizeBy: none
		sourceColumn: passports

	column manual_avoided_eur
		dataType: double
		summarizeBy: none
		sourceColumn: manual_avoided_eur

	column premium_eur
		dataType: double
		summarizeBy: none
		sourceColumn: premium_eur

	column circular_eur
		dataType: double
		summarizeBy: none
		sourceColumn: circular_eur

	column resale_eur
		dataType: double
		summarizeBy: none
		sourceColumn: resale_eur

	column recovery_eur
		dataType: double
		summarizeBy: none
		sourceColumn: recovery_eur

	column operating_eur
		dataType: double
		summarizeBy: none
		sourceColumn: operating_eur

	column investment_eur
		dataType: double
		summarizeBy: none
		sourceColumn: investment_eur

	column net_cash_eur
		dataType: double
		summarizeBy: none
		sourceColumn: net_cash_eur

	column discounted_cash_eur
		dataType: double
		summarizeBy: none
		sourceColumn: discounted_cash_eur

	column discounted_benefit_eur
		dataType: double
		summarizeBy: none
		sourceColumn: discounted_benefit_eur

	column discounted_cost_eur
		dataType: double
		summarizeBy: none
		sourceColumn: discounted_cost_eur

	column cumulative_cash_eur
		dataType: double
		summarizeBy: none
		sourceColumn: cumulative_cash_eur

	column data_label
		dataType: string
		summarizeBy: none
		sourceColumn: data_label

	column model_version
		dataType: string
		summarizeBy: none
		sourceColumn: model_version

	partition finance_cashflow = m
		mode: import
		source =
			#table(
				type table [scenario = text, year = Int64.Type, period = text, passports = Int64.Type, manual_avoided_eur = nullable number, premium_eur = nullable number, circular_eur = nullable number, resale_eur = nullable number, recovery_eur = nullable number, operating_eur = nullable number, investment_eur = nullable number, net_cash_eur = nullable number, discounted_cash_eur = nullable number, discounted_benefit_eur = nullable number, discounted_cost_eur = nullable number, cumulative_cash_eur = nullable number, data_label = text, model_version = text],
