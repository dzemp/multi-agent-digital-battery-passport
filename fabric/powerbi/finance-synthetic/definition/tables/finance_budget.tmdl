/// Entirely synthetic. SYN-FIN-2026-11. No external data source or approved financial input.
table finance_budget

	measure 'Base build forecast' = CALCULATE(SUM(finance_budget[forecast_eur]), REMOVEFILTERS(finance_scenarios), finance_budget[scenario] = "Base")
		formatString: "EUR "#,0;("EUR "#,0);"EUR "0

	measure 'Base build budget' = CALCULATE(SUM(finance_budget[budget_eur]), REMOVEFILTERS(finance_scenarios), finance_budget[scenario] = "Base")
		formatString: "EUR "#,0;("EUR "#,0);"EUR "0

	measure 'Budget headroom' = [Base build budget] - [Base build forecast]
		formatString: "EUR "#,0;("EUR "#,0);"EUR "0

	measure 'Headroom display' = IF(ISBLANK([Budget headroom]), "Not measured", "EUR " & FORMAT(DIVIDE([Budget headroom], 1000000), "0.00") & "m")

	column scenario
		dataType: string
		summarizeBy: none
		sourceColumn: scenario

	column month
		dataType: int64
		summarizeBy: none
		sourceColumn: month

	column period
		dataType: string
		summarizeBy: none
		sourceColumn: period
		sortByColumn: month

	column forecast_eur
		dataType: double
		summarizeBy: none
		sourceColumn: forecast_eur

	column budget_eur
		dataType: double
		summarizeBy: none
		sourceColumn: budget_eur

	column data_label
		dataType: string
		summarizeBy: none
		sourceColumn: data_label

	column model_version
		dataType: string
		summarizeBy: none
		sourceColumn: model_version

	partition finance_budget = m
		mode: import
		source =
			#table(
				type table [scenario = text, month = Int64.Type, period = text, forecast_eur = nullable number, budget_eur = nullable number, data_label = text, model_version = text],
