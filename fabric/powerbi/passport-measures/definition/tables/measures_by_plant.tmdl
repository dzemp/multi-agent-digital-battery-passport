/// Passport coverage, verified footprint and second life per plant of the newest app export. Synthetic; illustrative.
table measures_by_plant

	measure 'Plant coverage' = DIVIDE(SUM(measures_by_plant[published]), SUM(measures_by_plant[produced]))
		formatString: 0.0%

	measure 'Plant batteries without passport' = SUM(measures_by_plant[produced]) - SUM(measures_by_plant[published])
		formatString: 0

	measure 'Plant average footprint' = IF(HASONEVALUE(measures_by_plant[plant_id]), MAX(measures_by_plant[avg_footprint_per_kwh]))
		formatString: 0.00

	column export_id
		dataType: string
		summarizeBy: none
		sourceColumn: export_id

	column generated_utc
		dataType: string
		summarizeBy: none
		sourceColumn: generated_utc

	column plant_id
		dataType: string
		summarizeBy: none
		sourceColumn: plant_id

	column produced
		dataType: int64
		summarizeBy: none
		sourceColumn: produced

	column published
		dataType: int64
		summarizeBy: none
		sourceColumn: published

	column coverage_pct
		dataType: double
		summarizeBy: none
		sourceColumn: coverage_pct

	column verified_footprint_batteries
		dataType: int64
		summarizeBy: none
		sourceColumn: verified_footprint_batteries

	column avg_footprint_per_kwh
		dataType: double
		summarizeBy: none
		sourceColumn: avg_footprint_per_kwh

	column second_life_count
		dataType: int64
		summarizeBy: none
		sourceColumn: second_life_count

	column second_life_value_eur_illustrative
		dataType: double
		summarizeBy: none
		sourceColumn: second_life_value_eur_illustrative

	column data_label
		dataType: string
		summarizeBy: none
		sourceColumn: data_label

	partition measures_by_plant = entity
		mode: directLake
		source
			entityName: measures_by_plant
			schemaName: dbo
			expressionSource: DatabaseQuery
